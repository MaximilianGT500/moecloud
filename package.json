{
  "name": "moecloud",
  "version": "1.0.0",
  "private": true,
  "description": "Selbst gehostete Cloud für deine Dateien: hochladen, ordnen, teilen und per WebDAV einbinden.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "VITE_DEV_SERVER=http://localhost:5173 node --watch --disable-warning=ExperimentalWarning src/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/env.ts --test --test-concurrency=1 test/*.test.ts",
    "test:browser": "node --disable-warning=ExperimentalWarning test/browser.ts",
    "format": "prettier --write .",
    "check": "prettier --check . && npm run typecheck && npm test",
    "cli": "node --disable-warning=ExperimentalWarning cli.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@simplewebauthn/server": "^14.1.0",
    "argon2": "^0.45.2",
    "exifr": "^7.1.3",
    "fastify": "^5.12.8",
    "htm": "^3.1.1",
    "mime-types": "^3.0.2",
    "music-metadata": "^12.3.5",
    "nodemailer": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.2",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@material/material-color-utilities": "^0.4.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@rolldown/plugin-babel": "^0.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "docx-preview": "^0.4.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.10.1",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianGT500/moecloud.git"
  },
  "author": "MaximilianGT500",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MaximilianGT500/moecloud/issues"
  },
  "keywords": [
    "moecloud",
    "cloud",
    "files",
    "webdav",
    "selfhosted",
    "nextcloud-alternative",
    "google-drive-alternative",
    "docker",
    "sqlite"
  ]
}
