# ============================================================================
# MoeCloud mit Docker: Vorlage für die Datei .env
# ============================================================================
#
# Kopier diese Datei als .env neben die docker-compose.yml und trag ein, was du
# brauchst. Unverändert ändert sie nichts: Alle Werte stehen auf dem Standard.
#
# Läuft MoeCloud schon, ersetz deine .env nicht durch diese Datei. Dort stehen
# Werte, ohne die deine Installation nicht mehr startet oder ihre Daten nicht
# mehr findet, etwa POSTGRES_PASSWORD, COMPOSE_FILE und DOMAIN. Übernimm
# stattdessen nur die Zeilen, die du brauchst.
#
# Schreibweise
#   NAME=wert     ohne Leerzeichen um das Gleichheitszeichen
#   NAME=         leer heißt Standard
#   # Text        Zeilen mit # am Anfang sind Kommentare
#
# Steht in einem Wert ein $, ein # nach einem Leerzeichen oder ein Leerzeichen
# am Rand, setz ihn in einfache Anführungszeichen. Sonst kommt er verändert an:
#   SMTP_PASSWORD='pa$$wort #1'
#
# Ist eine Variable schon in der Shell gesetzt, aus der du docker compose
# startest, gilt der Wert aus der Shell und nicht der aus dieser Datei.
#
# Änderungen gelten, sobald Docker den Container neu anlegt:
#   docker compose up -d
# Mit dem Installationsskript heißt das sudo moecloud start. Ein restart allein
# übernimmt Änderungen aus dieser Datei nicht.
#
# Fast alles andere stellst du im Browser unter Admin › Einstellungen ein. Hier
# steht nur, was MoeCloud schon beim Start wissen muss.


# ----------------------------------------------------------------------------
# Image und Erreichbarkeit
# ----------------------------------------------------------------------------

# Tag des Images. MoeCloud läuft mit latest, dem neuesten Stand. Das
# Installationsskript trägt hier nichts ein und nimmt ohne die Zeile latest.
#   latest        das neueste Image
#   sha-1a2b3c4   das Image zu genau diesem Commit, um bei einem Stand zu
#                 bleiben. Welche es gibt, steht unter
#                 https://github.com/MaximilianGT500/moecloud/pkgs/container/moecloud
# Mit einem festen Tag bleiben auch sudo moecloud update und die automatischen
# Updates bei diesem Image. Ein älteres Image startet nicht, wenn ein neueres
# die Datenbank schon auf einen neuen Stand gebracht hat.
# Die frühere Variable MOECLOUD_VERSION gilt nicht mehr.
MOECLOUD_TAG=latest

# Port auf dem Server, unter dem MoeCloud erreichbar ist. Im Container bleibt
# es bei 3000.
MOECLOUD_PORT=3000

# Adresse auf dem Server, an die dieser Port gebunden ist.
#   0.0.0.0     von überall erreichbar
#   127.0.0.1   nur vom Server selbst, richtig hinter einem Reverse-Proxy
MOECLOUD_BIND=0.0.0.0

# Adresse, unter der Menschen MoeCloud öffnen, etwa https://cloud.example.com.
# Sie steht im Einrichtungslink im Log und als Vorschlag im Assistenten zur
# Einrichtung. Danach gilt die Adresse aus Admin › Einstellungen › Allgemein.
PUBLIC_URL=

# Welchen Reverse-Proxys MoeCloud die Kopfzeilen X-Forwarded-* glaubt. Davon
# hängt ab, welche IP-Adresse im Protokoll steht und ob MoeCloud HTTPS erkennt.
#   leer    Proxys auf demselben Server und in privaten Netzen
#   true    allen
#   false   keinem
#   sonst   Adressen oder Netze mit Komma getrennt: 10.0.0.5,172.18.0.0/16
TRUST_PROXY=


# ----------------------------------------------------------------------------
# HTTPS mit dem mitgelieferten Caddy
# ----------------------------------------------------------------------------
# Caddy holt die Zertifikate selbst. Dafür braucht es:
#   1. DOMAIN mit der Domain, die auf deinen Server zeigt
#   2. COMPOSE_PROFILES=caddy, damit Caddy mitstartet
#   3. MOECLOUD_BIND=127.0.0.1 weiter oben, damit Port 3000 nur noch auf dem
#      Server selbst erreichbar ist
#   4. PUBLIC_URL=https://deine-domain, solange MoeCloud nicht eingerichtet ist
# Die Ports 80 und 443 müssen frei sein und die Datei docker/Caddyfile muss da
# sein. Das Installationsskript richtet das alles ein, wenn du eine Domain
# angibst. Mehr im README unter „Mit eigener Domain und HTTPS“.

DOMAIN=
# COMPOSE_PROFILES=caddy


# ----------------------------------------------------------------------------
# Betrieb
# ----------------------------------------------------------------------------

# Zeitzone für das Log und die nächtliche Sicherung, als Name wie Europe/Berlin.
TZ=Europe/Berlin

# Wie viel im Log steht: debug, info, warn oder error.
LOG_LEVEL=info

# Form des Logs: pretty zum Lesen in der Konsole, json für Loki, Graylog und
# ähnliche Dienste.
LOG_FORMAT=pretty

# Benutzer und Gruppe auf dem Server, denen der Ordner data/ gehört. MoeCloud
# läuft im Container unter diesen Nummern und nicht als root. Beim Start passt
# es die Besitzrechte von data/ daran an. Deine Nummern zeigt der Befehl id.
PUID=1000
PGID=1000

# Wie viele Dateien gleichzeitig Vorschaubilder, Bildinfos und Suchtext
# bekommen, von 1 bis 16. Leer nimmt MoeCloud die Zahl der Prozessorkerne minus
# eins, höchstens 4.
PROCESSING_WORKERS=


# ----------------------------------------------------------------------------
# Datenbank
# ----------------------------------------------------------------------------

# Leer nutzt MoeCloud SQLite in data/moecloud.db. Das passt für die meisten.
# Für ein eigenes PostgreSQL ab Version 15 steht hier die Adresse:
#   DATABASE_URL=postgres://moecloud:passwort@db.example.com:5432/moecloud
# Sonderzeichen im Passwort schreibst du in der Adresse mit %, etwa %40 für @.
# Mit docker/postgres.yml setzt Docker die Adresse selbst, dann bleibt die
# Zeile leer.
DATABASE_URL=

# Nur mit docker/postgres.yml: Passwort für den mitgelieferten Container mit
# PostgreSQL. Erzeug es einmal, etwa mit openssl rand -hex 24, und ändere es
# danach nicht mehr, sonst kommt MoeCloud nicht mehr an seine Daten. Das
# Installationsskript erzeugt es selbst.
POSTGRES_PASSWORD=

# Zweiter Ordner, in den MoeCloud jede Sicherung der Datenbank zusätzlich
# kopiert, etwa auf einer anderen Platte. Gemeint ist der Pfad im Container:
# Häng den Ordner in der docker-compose.yml als Volume ein, zum Beispiel
# /mnt/nas/sicherungen:/backups, und trag hier /backups ein. Der Ordner muss
# dem Benutzer aus PUID gehören.
BACKUP_COPY_DIR=


# ----------------------------------------------------------------------------
# E-Mail
# ----------------------------------------------------------------------------
# Startwerte für den Versand über einen SMTP-Server. Sie gelten, bis du unter
# Admin › E-Mail etwas speicherst. Danach zählt, was dort steht.
# Sind SMTP_HOST und SMTP_FROM gesetzt, ist der Versand von Anfang an an.

# Adresse des Servers, etwa smtp.example.com
SMTP_HOST=

# Port. Leer nimmt MoeCloud 587, mit SMTP_SECURITY=tls 465.
SMTP_PORT=

# Verschlüsselung. Leer gilt starttls.
#   starttls   üblich mit Port 587
#   tls        üblich mit Port 465
#   none       unverschlüsselt, nur im eigenen Netz sinnvoll
SMTP_SECURITY=

# Anmeldung am Server. Ohne Benutzername meldet sich MoeCloud nicht an.
SMTP_USER=
SMTP_PASSWORD=

# Absender: die Adresse, etwa cloud@example.com, und der Name, der davor
# steht. Ohne Namen nimmt MoeCloud den Namen der Cloud.
SMTP_FROM=
SMTP_FROM_NAME=


# ----------------------------------------------------------------------------
# Anmeldung über SSO
# ----------------------------------------------------------------------------
# Startwerte für OpenID Connect, etwa mit Authentik, Keycloak oder Authelia.
# Was du unter Admin › Single Sign-on speicherst, hat Vorrang.
# Sind OIDC_ISSUER und OIDC_CLIENT_ID gesetzt, ist die Anmeldung von Anfang an
# an. Beim Anbieter trägst du als Redirect URI ein:
#   https://cloud.example.com/login/oidc/callback

# Issuer-URL des Anbieters, etwa https://auth.example.com/realms/home
OIDC_ISSUER=

# Client-ID und Client-Secret der Anwendung beim Anbieter. Ohne Secret gilt
# der Client als öffentlich und nutzt nur PKCE.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Text auf dem Knopf der Anmeldeseite. Leer steht dort „Mit SSO anmelden“.
OIDC_LABEL=

# true legt für neue Personen bei der ersten Anmeldung ein Konto an. Sonst
# kommen nur Menschen herein, die schon ein Konto haben.
OIDC_AUTO_CREATE=

# Name einer Gruppe beim Anbieter. Wer darin ist, wird Admin.
OIDC_ADMIN_GROUP=


# ----------------------------------------------------------------------------
# Virenscan und Office-Vorschau
# ----------------------------------------------------------------------------

# Adresse und Port eines eigenen Dienstes mit ClamAV. Leer gilt Port 3310.
# Ist CLAMAV_HOST gesetzt, ist der Virenscan von Anfang an eingeschaltet. Was
# du unter Admin › Virenscan speicherst, hat Vorrang.
# Mit docker/clamav.yml setzt Docker beides selbst, dann bleiben die Zeilen
# leer.
CLAMAV_HOST=
CLAMAV_PORT=

# Adresse eines eigenen Dienstes mit Gotenberg, der PowerPoint, OpenDocument
# und ältere Office-Dateien für die Vorschau umwandelt, etwa
# http://gotenberg:3000. Mit docker/office.yml setzt Docker sie selbst.
OFFICE_URL=


# ----------------------------------------------------------------------------
# Plugins
# ----------------------------------------------------------------------------

# off schaltet Plugins ganz ab. Leer sind sie möglich, laufen aber erst, wenn
# ein Admin sie unter Admin › Plugins freigibt.
PLUGINS=

# on erlaubt Admins, Plugins im Browser als ZIP hochzuladen und zu entfernen.
# Leer geht das nur auf dem Server, über den Ordner data/plugins/ oder die
# Kommandozeile.
PLUGIN_UPLOAD=

# on schaltet den Entwicklermodus ein: MoeCloud prüft keine Prüfsummen und
# lädt geänderte Plugins von selbst neu. Nichts für einen Server, den andere
# benutzen.
PLUGINS_DEV=


# ----------------------------------------------------------------------------
# Verbindungen nach außen und Überwachung
# ----------------------------------------------------------------------------

# Einmal am Tag fragt MoeCloud nach einer neuen Version. Abgerufen wird nur
# diese eine Datei, ohne Angaben über deinen Server.
#   leer    https://moecloud.moestudio.net/version.json
#   off     fest aus, auch in der Verwaltung nicht einschaltbar
#   sonst   eigene Adresse, etwa für einen Fork
UPDATE_CHECK_URL=

# Prüft neue Passwörter gegen bekannte Datenlecks, wenn das unter
# Admin › Einstellungen › Anmeldung eingeschaltet ist. Übertragen werden nur
# die ersten fünf Zeichen einer Prüfsumme, nie das Passwort.
#   leer    https://api.pwnedpasswords.com/range
#   off     fest aus
#   sonst   eigene Quelle mit derselben Schnittstelle
BREACH_CHECK_URL=

# Token für die Zahlen unter /metrics im Format von Prometheus. Ohne Token
# gibt es die Adresse nicht. Du kannst es auch unter Admin › System erzeugen,
# das Token von hier hat Vorrang.
METRICS_TOKEN=


# ----------------------------------------------------------------------------
# Zusatzdienste und Installationsskript
# ----------------------------------------------------------------------------
# Diese Zeilen setzt das Installationsskript selbst. Ohne das Skript trägst du
# sie bei Bedarf von Hand ein und nimmst dafür das # am Anfang weg.

# Welche Compose-Dateien zusammen gelten, mit Doppelpunkt getrennt. Jede
# Ergänzung bringt einen Dienst mit:
#   docker/clamav.yml     Virenscan mit ClamAV
#   docker/postgres.yml   PostgreSQL, braucht POSTGRES_PASSWORD
#   docker/office.yml     Office-Vorschau
# COMPOSE_FILE=docker-compose.yml:docker/clamav.yml:docker/postgres.yml:docker/office.yml

# Wie MoeCloud installiert ist, damit die Verwaltung den passenden Befehl zum
# Aktualisieren zeigt: docker oder script.
# MOECLOUD_INSTALL=docker


# ----------------------------------------------------------------------------
# Nur ohne Docker
# ----------------------------------------------------------------------------
# Diese Variablen reicht die docker-compose.yml nicht in den Container weiter,
# in einer .env für Docker bewirken sie nichts. Sie gelten für den Betrieb mit
# Node.js. Dort liest MoeCloud keine .env von selbst, du startest es so:
#   node --env-file=.env --disable-warning=ExperimentalWarning src/server.ts
# Dann gelten auch die Variablen von oben, bis auf MOECLOUD_TAG,
# MOECLOUD_PORT, MOECLOUD_BIND, PUID, PGID, DOMAIN, POSTGRES_PASSWORD und die
# Zeilen für Compose.

# Port und Adresse, auf denen MoeCloud lauscht.
# PORT=3000
# HOST=0.0.0.0

# Ordner für Datenbank und Dateien, sonst data/ im Projekt.
# DATA_DIR=/srv/moecloud

# Datei, aus der MoeCloud die Adresse der Datenbank liest, statt DATABASE_URL.
# DATABASE_URL_FILE=/run/secrets/moecloud-datenbank

# Ordner für Plugins, sonst plugins/ im Datenordner.
# PLUGINS_DIR=/srv/moecloud-plugins

# Unix-Socket von ClamAV statt Adresse und Port.
# CLAMAV_SOCKET=/run/clamav/clamd.ctl

# Pfade zu den Programmen für Vorschauen. Leer sucht MoeCloud sie im PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# PDFTOPPM_PATH=
# PDFTOTEXT_PATH=

# Pfad zu LibreOffice für die Office-Vorschau, sonst sucht MoeCloud soffice
# im PATH.
# SOFFICE_PATH=
